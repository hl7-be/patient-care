  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "patient1"] ;
  fhir:Resource.meta [
     fhir:Meta.profile [
       fhir:value "https://www.ehealth.fgov.be/standards/fhir/core/StructureDefinition/be-patient" ;
