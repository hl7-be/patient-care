     fhir:Identifier.system [ fhir:value "https://www.ehealth.fgov.be/standards/fhir/core/NamingSystem/ssin" ] ;
     fhir:Identifier.value [ fhir:value "99999999999" ]
  ] ;
  fhir:Patient.name [
     fhir:index 0 ;
     fhir:HumanName.family [ fhir:value "Doe" ] ;
     fhir:HumanName.given [
       fhir:value "Jane" ;
       fhir:index 0
     ]
  ] ;
  fhir:Patient.gender [ fhir:value "female"] ;
  fhir:Patient.birthDate [ fhir:value "1956-05-27"^^xsd:date] .

